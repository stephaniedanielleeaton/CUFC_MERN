# Dedicated test member account — must be a Username-Password-Authentication user in Auth0
# (not a social login), with no MFA.
E2E_TEST_EMAIL=<test-user@yourdomain.com>
E2E_TEST_PASSWORD=<test-user-password>

# Dedicated test admin account — must be a Username-Password-Authentication user in Auth0
# (not a social login), with no MFA, and admin permissions assigned in the app.
E2E_ADMIN_EMAIL=<test-admin@yourdomain.com>
E2E_ADMIN_PASSWORD=<test-admin-password>

# Optional: override the base URL for the e2e tests. If unset, it defaults to
# http://localhost:5173. Already-set environment variables (e.g. BASE_URL passed by
# test-all.js) take precedence over this file.
# BASE_URL=http://localhost:5173

# Square API credentials for test fixtures (manages test variations on existing catalog items)
# Use the same sandbox credentials as the server
SQUARE_ACCESS_TOKEN=<your-square-sandbox-access-token>
SQUARE_RETAIL_LOCATION_ID=<your-square-sandbox-location-id>
INTRO_CLASS_CATALOG_OBJECT_ID=<your-intro-class-catalog-object-id>
